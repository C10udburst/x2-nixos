# Render the model registry into the switcher's wire format.
#
# Deliberately **not** JSON: this file is written by Nix and read by the Rust router, which has
# no JSON dependency and must resolve a request's model without one. One model per line, tab
# separated, in exactly the field order `src/registry.rs` parses:
#
#   devices \t id \t service \t remapped \t url \t model_dir \t engine \t capabilities
#
# * `devices` is a comma separated domain list (`gpu`, `npu`, `gpu,npu`). The router takes every
#   listed domain's lock in canonical order, so a future two-accelerator model needs no code
#   change here beyond emitting `gpu,npu`.
# * `@default` names the model served when a request specifies none; an empty value means boot
#   with nothing resident.
# * Tabs/newlines/backslashes are escaped so no field can forge a field boundary.

{
  lib,
  pkgs,
  models,
  defaultModel,
}: let
  escapeField = value:
    builtins.replaceStrings [ "\\" "\t" "\r" "\n" ] [ "\\\\" "\\t" "\\r" "\\n" ]
      (toString value);

  field = value: escapeField value;

  line = name: m:
    lib.concatStringsSep "\t" [
      (field m.device)
      (field name)
      (field m.serviceName)
      (field m.remappedModel)
      (field m.url)
      (field m.modelDir)
      (field m.type)
      (field (lib.concatStringsSep "," m.capabilities))
    ];

  text =
    "# generated by modules/switcher/registry.nix - do not edit\n"
    + "@default\t"
    + (if defaultModel == null then "" else escapeField defaultModel)
    + "\n"
    + lib.concatStringsSep "\n" (lib.mapAttrsToList line models)
    + "\n";
in
pkgs.writeText "model-registry.tsv" text
